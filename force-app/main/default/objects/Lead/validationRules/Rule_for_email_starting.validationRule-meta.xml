<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rule_for_email_starting</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Email)),
    REGEX(
        LOWER(Email),
        &quot;^(info@|contact@|career@).*&quot;
    )
)</errorConditionFormula>
    <errorMessage>Lead emails starting with info@, contact@, or career@ are not allowed.</errorMessage>
</ValidationRule>
