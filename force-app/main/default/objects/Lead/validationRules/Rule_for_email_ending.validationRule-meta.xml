<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rule_for_email_ending</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Email)),
    REGEX(
        LOWER(Email),
        &quot;.*\\.(games|garden|glass|free|talk)$&quot;
    )
)</errorConditionFormula>
    <errorMessage>Email addresses ending with .games, .garden, .glass, .free, or .talk are not allowed.</errorMessage>
</ValidationRule>
