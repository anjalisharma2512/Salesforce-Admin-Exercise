<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Email_contains_A</fullName>
    <active>true</active>
    <errorConditionFormula>CONTAINS(LOWER(MID(Email, 5, 8)), &quot;a&quot;)</errorConditionFormula>
    <errorMessage>The email address cannot contain the letter &apos;a&apos; between the 5th and 12th characters.</errorMessage>
</ValidationRule>
