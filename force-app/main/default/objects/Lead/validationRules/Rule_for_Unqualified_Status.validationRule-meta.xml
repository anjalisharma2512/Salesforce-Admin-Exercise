<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rule_for_Unqualified_Status</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISNEW()),
    NOT(ISCLONE()),
    ISPICKVAL(Status, &quot;Unqualified&quot;),
    ISBLANK(Reason__c)
)</errorConditionFormula>
    <errorMessage>Please provide a Reason when marking a Lead as Unqualified</errorMessage>
</ValidationRule>
