<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Rule_for_Email_Phone</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISBLANK( Email ) ,  ISBLANK( Phone ) )</errorConditionFormula>
    <errorMessage>Please provide either an Email or Phone number.</errorMessage>
</ValidationRule>
